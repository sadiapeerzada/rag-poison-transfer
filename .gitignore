# Environments
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Data (large / regeneratable / not ours to redistribute)
data/raw/*
!data/raw/toy_smoke_dataset.json
data/processed/
data/poisoned/

# Results (raw per-query logs) -- TRACKED by default now, not ignored.
# Every real experiment (exp_00N_*.jsonl) is traceable evidence per the
# reproducibility rules; committing it directly means no manual copy-into-
# experiments/ step to remember and forget. Only throwaway/dev-loop runs
# (smoke tests, ad-hoc debug runs) are excluded -- these aren't real
# results and don't need a permanent record.
# Exception: exp_009_hotpotqa_retrieval_eval_smoke.jsonl is force-committed
# as evidence for the current-schema retrieval metrics implementation (see README).
results/*smoke*.jsonl
results/*debug*.jsonl
results/*_scratch*.jsonl
logs/

# Model weights if ever cached locally
*.safetensors
*.gguf
mlx_models/

# OS
.DS_Store
